# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Public hostnames the tunnel serves (set up in Cloudflare Zero Trust).
BRICKPIPE_HOSTNAME=bricks.example.com
NOVA_HOSTNAME=nova.example.com

# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Install connector.
TUNNEL_TOKEN=

# Your first name, shown on the "Use <name>'s AI account" toggle.
BRICKPIPE_HOST_NAME=

# Optional: a Rebrickable key the server uses for everyone (free, rebrickable.com > Settings > API).
REBRICKABLE_API_KEY=

# Optional: Nova's own keys, if you would rather not paste them into Nova's UI.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Optional: experimental features, e.g. prices
BRICKPIPE_FEATURES=
