# Copy to deploy/.env and fill in. Never commit deploy/.env: it holds secrets.
# Every value below is a placeholder.

# --- Addresses ---------------------------------------------------------------
# brickpipe's public hostname (set up in Cloudflare; update.sh prints it).
BRICKPIPE_HOSTNAME=bricks.example.com
# Nova's public hostname; brickpipe's links into Nova use it.
NOVA_HOSTNAME=nova.example.com

# --- Cloudflare tunnel ---------------------------------------------------------
# The connector token from Cloudflare Zero Trust > Networks > Tunnels (see docs/server-setup.md).
TUNNEL_TOKEN=paste-the-tunnel-token-here
# cloudflared image tag; pinned so updates are deliberate. Releases: github.com/cloudflare/cloudflared/releases
CLOUDFLARED_VERSION=2026.9.3

# --- brickpipe -----------------------------------------------------------------
# Your first name, shown on the "Use <name>'s AI account" toggle.
BRICKPIPE_HOST_NAME=
# Optional: one Rebrickable key the server uses for everyone (free, rebrickable.com > Settings > API).
REBRICKABLE_API_KEY=
# Optional: experimental features, comma separated, e.g. prices.
BRICKPIPE_FEATURES=

# --- Nova's AI account -----------------------------------------------------------
# Recommended: leave these empty and sign in with your Claude account in Nova's
# Settings (kept in the brickpipe_nova-config volume across restarts and rebuilds).
# Alternative: an API key. Nova uses it for model entries that have no key of their own.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional: the TYPESAFE_API_KEY Nova's toolkit commands use (Nova shows it under Settings > Environment).
TYPESAFE_API_KEY=

# --- Memory limits (the server is small; raise them if a container is OOM-killed) ---
# Nova renders and runs the AI agents: the big one.
NOVA_MEM_LIMIT=3g
BRICKPIPE_MEM_LIMIT=512m
TUNNEL_MEM_LIMIT=128m

# --- Scripts only (not read by docker compose) ---------------------------------
# Where deploy/backup.sh writes its archives (empty: ~/lego/backups), and how many it keeps.
BACKUP_DIR=
BACKUP_KEEP=7
# What deploy/update.sh checks out for the two Nova repos.
NOVA_DOCKER_REF=master
NOVA_TOOLKIT_REF=v0.6.0
